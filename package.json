{
  "name": "roll_together_backend",
  "version": "0.2.0",
  "description": "Backend for Roll Together Chrome Extension",
  "main": "server.js",
  "scripts": {
    "build": "tsc",
    "start": "npm run build && npm run start:prod",
    "start:dev": "nodemon --config nodemon.json src/server.ts",
    "start:prod": "node ./build/server.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samuraiexx/roll_together_backend.git"
  },
  "keywords": [
    "Chrome",
    "Extension",
    "Crunchyroll",
    "Party"
  ],
  "author": "SamuraiExx",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/samuraiexx/roll_together_backend/issues"
  },
  "homepage": "https://github.com/samuraiexx/roll_together_backend#readme",
  "dependencies": {
    "express": "^5.2.1",
    "socket.io": "^4.8.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "nodemon": "^3.1.14"
  },
  "optionalDependencies": {
    "fsevents": "2.3.3"
  }
}
