{
    "compilerOptions": {
        "target": "ES2022",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "esModuleInterop": true,
        "rootDir": "./src",
        "outDir": "./build",
        "strict": true,
        "skipLibCheck": true
    },
    "include": ["./src/*"],
    "exclude": ["./node_modules/**"]
}
